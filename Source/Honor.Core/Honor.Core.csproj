<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>../../Mods/Honor.Core/$(RimWorldVersion)/Assemblies/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Honor.Rules/Honor.Rules.csproj" />
    <Reference Include="Assembly-CSharp" Condition="'$(RimWorldVersion)' != '1.6'"><HintPath>$(RimWorldDir)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs" Condition="'$(RimWorldVersion)' != '1.6'"><HintPath>$(RimWorldDir)/UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Waylith" Condition="'$(RimWorldVersion)' != '1.6'"><HintPath>$(RimWorldDir)/Waylith.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(HarmonyDll)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(RimWorldVersion)' != '1.6' and !Exists('$(RimWorldDir)/Assembly-CSharp.dll')" Text="Set RimWorldDir in GamePaths.props to the verified RimWorld 1.7 install." />
    <Error Condition="!Exists('$(HarmonyDll)')" Text="Set HarmonyDll (1.7 / Harmony 3) or Harmony16Dll (1.6 / Harmony 2) in GamePaths.props." />
  </Target>
</Project>
