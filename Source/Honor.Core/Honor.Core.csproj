<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>../../Mods/Honor.Core/1.7/Assemblies/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Honor.Rules/Honor.Rules.csproj" />
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorldDir)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(RimWorldDir)/UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Waylith"><HintPath>$(RimWorldDir)/Waylith.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(HarmonyDll)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(RimWorldDir)/Assembly-CSharp.dll')" Text="Set RimWorldDir in GamePaths.props to the verified RimWorld 1.7 install." />
    <Error Condition="!Exists('$(HarmonyDll)')" Text="Set HarmonyDll to the installed 1.7 Harmony 3 assembly." />
  </Target>
</Project>
